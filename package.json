{
  "name": "react-example",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "dev:remote-readonly": "vite --mode remote-readonly --port=3000 --host=127.0.0.1",
    "server": "node --env-file-if-exists=.env server/index.js",
