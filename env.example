# 로컬 백엔드 서버 설정 (server/index.js). 값을 지정하지 않으면 아래 기본값을 사용합니다.
PORT=3001
WMS_DB_PATH=server/data/db.sqlite3
WMS_UPLOADS_DIR=server/uploads

# scenario-manager 스크래퍼(sm Scraper)가 /api/scenarios/sync 호출 시 사용하는 공유 시크릿.
# 값이 없으면 해당 엔드포인트는 항상 401을 반환합니다.
SCRAPER_API_KEY=

# ── Scenario Manager(SM) 연동 ────────────────────────────────
# 재고·대여 동기화(server/lib/smSync.js). 관리자가 WMS에 로그인할 때 같은 자격증명으로
# SM에도 로그인해 세션을 얻어 쓰므로 여기에 비밀번호를 적지 않습니다.
SM_URL=http://100.92.161.29
# 정기 회차(초). 재고를 바꾸는 동작마다 곧바로 맞추므로 이 값은 그물망 역할만 한다.
SM_SYNC_INTERVAL=300
# SM_SYNC=off 로 두면 동기화를 끕니다.

# 오브젝트 등록 연동(server/lib/smObjects.js). SM이 오브젝트 번호를 부여하고
# WMS가 그 번호로 물품을 만듭니다. 재고 동기화와 달리 사람 세션이 아니라
# SM이 발급하는 서비스 토큰을 씁니다 — 이 값이 비어 있으면 등록 연동은 꺼진 것으로
# 동작하고, 관리자가 지금까지처럼 번호를 직접 입력하게 됩니다.
SM_COS_TOKEN=
# SM에 "누가 처리했는지"로 남을 이름과 권한. SM 담당자가 알려주는 값을 씁니다.
SM_COS_ACTOR=wms
SM_COS_ROLE=cos_admin
SM_COS_COUNTRY=KR
SM_COS_REGIONS=KR
# WMS 물품에 구역이 비어 있을 때 SM에 보낼 기본 구역(SM은 sector가 필수입니다).
SM_COS_SECTOR=warehouse

# 토큰이 없을 때는 관리자 로그인 세션으로 SM 등록 화면과 같은 요청을 보냅니다
# (server/lib/smObjectsSession.js). 별도 설정 없이 동작하지만, SM 등록 화면이 요구하는
# 아래 세 항목은 WMS에 대응하는 개념이 없어 기본값을 씁니다.
SM_OBJ_TYPE=Obj
SM_OBJ_SIZE=Medium
SM_OBJ_PROPERTY=Hard
